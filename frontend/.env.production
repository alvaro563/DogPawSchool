# Loaded by `vite build` (mode=production) and takes precedence
# over .env. The SPA is served by a Render static site that proxies
# /api/* to the backend (see render.yaml), so the API is
# SAME-ORIGIN from the browser's point of view: a relative base URL
# keeps session cookies first-party (no CORS, no third-party cookie
# blocking). Do NOT set an absolute backend URL here.
VITE_API_BASE_URL=/api/v1
