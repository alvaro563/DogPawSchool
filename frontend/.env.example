# API base URL. Two configurations are supported:
#
#   1. Development with the Vite proxy (recommended): leave
#      VITE_API_BASE_URL as /api/v1 and set VITE_API_PROXY_TARGET
#      to the backend. The Vite dev server forwards /api/* to
#      VITE_API_PROXY_TARGET, so the SPA's fetch calls are
#      same-origin and bypass CSP/CORS concerns.
#
#   2. Direct cross-origin (no proxy): set VITE_API_BASE_URL to
#      the absolute URL of the API. This requires CORS_ORIGINS on
#      the backend to include the SPA origin and is more brittle
#      for local dev.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080
