# Ejecutables compilados de Go (los que creas con go build)
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
out/
/api

# Herramientas de test y coberturas
*.out
*.prof
*.test

# Configuraciones locales y secretos (¡NUNCA subas estos!)
.env
.env.*
config.local.yaml

# Plantillas versionadas (las puede ver todo el mundo).
# Los archivos reales (con secretos) están ignorados por las reglas
# `.env` / `.env.*` de arriba.
!cmd/api/.env.example
!frontend/.env.example

# Build de producción del SPA: solo contiene la URL relativa del API
# (/api/v1, sin secretos). Debe viajar al repo para que el build en
# Render sea determinista aunque no exista ningún .env en el clone.
!frontend/.env.production

# docker-compose local env (Postgres password, etc.)
docker-compose.override.yml

# Carpetas de editores (VS Code, GoLand...)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Logs del sistema
*.log